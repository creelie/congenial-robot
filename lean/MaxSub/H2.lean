      have h11 : e11 ∈ S := S.sup_mem h2 h1
      have h6 : e6 ∈ S := S.sup_mem h3 h1
      have h7 : e7 ∈ S := S.inf_mem h13 h12
      exact eq_top_iff.2 fun x _ => by cases x <;> assumption
    | e9 => exact absurd ((mem_M _).2 rfl) hcM
    | e10 => exact absurd ((mem_M _).2 rfl) hcM
    | e11 =>
      have h11 : e11 ∈ S := hcS
      have h1 : e1 ∈ S := S.inf_mem h9 h11
      have h6 : e6 ∈ S := S.sup_mem h3 h1
      have h4 : e4 ∈ S := S.inf_mem h10 h11
      have h8 : e8 ∈ S := S.sup_mem h2 h4
      have h12 : e12 ∈ S := S.sup_mem h3 h4
      have h7 : e7 ∈ S := S.inf_mem h13 h11
      exact eq_top_iff.2 fun x _ => by cases x <;> assumption
    | e12 =>
      have h12 : e12 ∈ S := hcS
      have h1 : e1 ∈ S := S.inf_mem h9 h12
      have h11 : e11 ∈ S := S.sup_mem h2 h1
      have h6 : e6 ∈ S := S.sup_mem h3 h1
      have h4 : e4 ∈ S := S.inf_mem h10 h12
      have h8 : e8 ∈ S := S.sup_mem h2 h4
      have h7 : e7 ∈ S := S.inf_mem h13 h12
      exact eq_top_iff.2 fun x _ => by cases x <;> assumption
    | e13 => exact absurd ((mem_M _).2 rfl) hcM
    | e14 => exact absurd ((mem_M _).2 rfl) hcM
    | e15 => exact absurd ((mem_M _).2 rfl) hcM
    | e16 => exact absurd ((mem_M _).2 rfl) hcM

/-- `L17` is join semidistributive. -/
theorem sdSup : ∀ a b c : L17, a ⊔ b = a ⊔ c → a ⊔ b = a ⊔ (b ⊓ c) := by decide +kernel

/-- `L17` is lower semimodular. -/
instance : IsLowerModularLattice L17 where
  inf_covBy_of_covBy_sup {a b} h := by
    have key : ∀ a b : L17, a ⋖ a ⊔ b → a ⊓ b ⋖ b := by decide +kernel
    exact key a b h

/-- The complement of `M` has no least element. -/
theorem no_least : ¬∃ z : L17, z ∉ M ∧ ∀ c : L17, c ∉ M → z ≤ c := by
  rintro ⟨z, hz, h⟩
  have key : ∀ z : L17, inM z = false → ¬(z ≤ e1 ∧ z ≤ e4) := by decide +kernel
  exact key z (by simpa [mem_M] using hz) ⟨h e1 (fun h' => absurd ((mem_M _).1 h') (by decide +kernel)),
    h e4 (fun h' => absurd ((mem_M _).1 h') (by decide +kernel))⟩

theorem e1_not_mem : e1 ∉ M := fun h => absurd ((mem_M _).1 h) (by decide +kernel)

theorem e4_not_mem : e4 ∉ M := fun h => absurd ((mem_M _).1 h) (by decide +kernel)

theorem e7_not_mem : e7 ∉ M := fun h => absurd ((mem_M _).1 h) (by decide +kernel)

/-- `e1 = a` is join-irreducible. -/
theorem supIrred_e1 : SupIrred e1 := by
  refine ⟨fun h => absurd (h (show e0 ≤ e1 by decide +kernel)) (by decide +kernel), ?_⟩
  have key : ∀ b c : L17, b ⊔ c = e1 → b = e1 ∨ c = e1 := by decide +kernel
  exact fun b c hbc => key b c hbc

/-- No lower cover of `e7 = ad` lies in `M`. -/
theorem lowerCovers_e7 : ∀ m : L17, m ⋖ e7 → m ∉ M := by
  have key : ∀ m : L17, m ⋖ e7 → inM m = false := by decide +kernel
  intro m hm h
  have := (mem_M _).1 h
  rw [key m hm] at this
  exact Bool.false_ne_true this

end L17

/-- **Hypothesis 2 fails**, already for convex geometries: there is a finite join-semidistributive,
lower semimodular lattice with a maximal proper sublattice whose complement has no least element. -/
theorem not_hypothesis2 :
    ¬∀ (α : Type) [Lattice α] [Finite α] [IsLowerModularLattice α],
      (∀ a b c : α, a ⊔ b = a ⊔ c → a ⊔ b = a ⊔ (b ⊓ c)) →
      ∀ M : Sublattice α, IsCoatom M → ∃ z : α, z ∉ M ∧ ∀ c : α, c ∉ M → z ≤ c :=
  fun h => L17.no_least (h L17 L17.sdSup L17.M L17.isCoatom_M)

/-- **Hypothesis 4 fails**: in the convex geometry `L17` the element `ad` of the complement of a
maximal sublattice has no lower cover in the sublattice. -/
theorem not_hypothesis4 :
    ¬∀ (α : Type) [Lattice α] [Finite α] [IsLowerModularLattice α],
      (∀ a b c : α, a ⊔ b = a ⊔ c → a ⊔ b = a ⊔ (b ⊓ c)) →
      ∀ M : Sublattice α, IsCoatom M → ∀ x : α, x ∉ M → ∃ m : α, m ⋖ x ∧ m ∈ M := by
  intro h
  obtain ⟨m, hm, hmM⟩ := h L17 L17.sdSup L17.M L17.isCoatom_M L17.e7 L17.e7_not_mem
  exact L17.lowerCovers_e7 m hm hmM

/-- **The join half of Question 2 fails**: the join-irreducible element `a` of the complement is not
below the element `d` of the complement, so it is not the least element of the complement. -/
theorem not_question2_join :
    ¬∀ (α : Type) [Lattice α] [Finite α] [IsLowerModularLattice α],
      (∀ a b c : α, a ⊔ b = a ⊔ c → a ⊔ b = a ⊔ (b ⊓ c)) →
      ∀ M : Sublattice α, IsCoatom M → ∀ j : α, j ∉ M → SupIrred j → ∀ c : α, c ∉ M → j ≤ c :=
  fun h => absurd (h L17 L17.sdSup L17.M L17.isCoatom_M L17.e1 L17.e1_not_mem L17.supIrred_e1
    L17.e4 L17.e4_not_mem) (by decide +kernel)

end MaxSub
